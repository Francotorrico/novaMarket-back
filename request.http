### 
GET http://localhost:5000



### Health check
GET http://localhost:5000/api/health
Accept: application/json

### ========================================
### AUTH - Register
### ========================================
POST http://localhost:5000/api/auth/register
Content-Type: application/json

{
  "name": "Franco Test",
  "email": "franco@test.com",
  "password": "123456"
}

### ========================================
### AUTH - Register (email existente)
### ========================================
POST http://localhost:5000/api/auth/register
Content-Type: application/json

{
  "name": "Franco Test",
  "email": "franco@test.com",
  "password": "123456"
}

### ========================================
### AUTH - Login
### ========================================
POST http://localhost:5000/api/auth/login
Content-Type: application/json

{
  "email": "franco@test.com",
  "password": "123456"
}

### ========================================
### AUTH - Login (credenciales inválidas)
### ========================================
POST http://localhost:5000/api/auth/login
Content-Type: application/json

{
  "email": "franco@test.com",
  "password": "wrongpassword"
}

### ========================================
### Middleware - Sin token (debería 401)
### ========================================
GET http://localhost:5000/api/products
Content-Type: application/json

### ========================================
### Middleware - Token inválido (debería 403)
### ========================================
GET http://localhost:5000/api/products
Authorization: Bearer token_invalido_12345
Content-Type: application/json

### ========================================
### AUTH - Perfil del usuario (protegido)
### ========================================
### <TOKEN_USER> debe ser el token de un usuario válido cuaalquiera (admin o cliente)
GET http://localhost:5000/api/auth/me
Authorization: Bearer <TOKEN_USER>
Content-Type: application/json

### ========================================
### AUTH - Perfil sin token (debería 401)
### ========================================
GET http://localhost:5000/api/auth/me
Content-Type: application/json


### producst
GET http://localhost:5000/api/products
Accept: application/json

### ========================================
### PRODUCTS - Listado de productos
### ========================================
GET http://localhost:5000/api/products
Accept: application/json

### ========================================
# PRODUCTS - Listado de productos (filtrado por category)
### ====================================
GET http://localhost:5000/api/products?category=accesorios
Accept: application/json

### ========================================
### PRODUCTS - Producto por ID
### ========================================
GET http://localhost:5000/api/products/64abc123def456789
Accept: application/json

### ========================================
### PRODUCTS - Crear producto (solo admin)
### ========================================
POST http://localhost:5000/api/products
Authorization: Bearer <TOKEN_ADMIN>
# Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpZCI6IjZhNjBjNDUxYjJjZTdhYmUyZGM2MDlhNyIsInJvbGUiOiJjbGllbnQiLCJpYXQiOjE3ODQ3MjY2MTAsImV4cCI6MTc4NTMzMTQxMH0.SrTzUX4Y7zDKg6_HGHwxq0OHchbQWD0KcwtVLM6bJrY
Content-Type: application/json

{
  "name": "Teclado mecánico",
  "description": "Switches rojos",
  "price": 4500,
  "category": "periféricos",
  "stock": 10
}

### ========================================
### PRODUCTS - Actualizar producto (solo admin)
### ========================================
PUT http://localhost:5000/api/products/64abc123def456789
Authorization: Bearer <TOKEN_ADMIN>
Content-Type: application/json

{
  "price": 5000,
  "stock": 5
}

### ========================================
### PRODUCTS - Eliminar producto (solo admin)
### ========================================
DELETE http://localhost:5000/api/products/64abc123def456789
Authorization: Bearer <token_admin>

### ========================================
### ORDERS
### ========================================

### ========================================
### ORDERS - Crear pedido (requiere auth)
### Reemplaza <TOKEN_CLIENT> y <PRODUCT_ID> por los reales
### ========================================
POST http://localhost:5000/api/orders
Authorization: Bearer <TOKEN_CLIENT>
Content-Type: application/json

{
  "items": [
    { "productId": "6a622637fe8584b5f89e9a71", "quantity": 2 }
  ],
  "shippingAddress": "Av. Siempre Viva 123, CABA"
}

### ========================================
### ORDERS - Mis pedidos (requiere auth)
### ========================================
GET http://localhost:5000/api/orders/my
Authorization: Bearer <TOKEN_CLIENT>

### ========================================
### ORDERS - Todos los pedidos (solo admin)
### ========================================
GET http://localhost:5000/api/orders
Authorization: Bearer <TOKEN_ADMIN>

### ========================================
### ORDERS - Actualizar status (solo admin)
### status: pending | paid | shipped | delivered | cancelled
### ========================================
PUT http://localhost:5000/api/orders/<ORDER_ID>/status
Authorization: Bearer <TOKEN_ADMIN>
Content-Type: application/json

{
  "status": "shipped"
}

### ========================================
### ORDERS - Sin token (debería 401)
### ========================================
GET http://localhost:5000/api/orders/my